# nginx na frente do app (caminho B em docs/DEPLOY.md; serve também para o Docker sem Caddy).
# Copie para /etc/nginx/sites-available/mosaic-crochet, troque mosaic.example.com pelo seu domínio
# e siga docs/DEPLOY.md para emitir o certificado com o certbot antes de ativar o bloco 443.
# No env do app: PUBLIC_ORIGIN=https://mosaic.example.com e TRUST_PROXY=1.

# HTTP: só responde ao desafio do Let's Encrypt e redireciona o resto para HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name mosaic.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: termina o TLS e repassa tudo para o app em 127.0.0.1:3000.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mosaic.example.com;

    ssl_certificate     /etc/letsencrypt/live/mosaic.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mosaic.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # O app recusa corpos acima de 256 KiB; 1m dá folga sem abrir a porta para uploads grandes.
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # $remote_addr (e não $proxy_add_x_forwarded_for): o cliente não consegue forjar o próprio IP,
        # que é a chave do rate limit.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
