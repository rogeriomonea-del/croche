# Configuração do Mosaic Crochet (SPEC §9.5), lida e validada no boot: um valor inválido derruba o
# processo com uma mensagem que diz qual variável corrigir.
#
# Docker: copie para .env na raiz do projeto.  systemd: copie para /etc/mosaic-crochet.env.
# Comentários só em linha própria: o systemd não aceita comentário no fim da linha.
# Variável vazia (NOME=) vale o padrão; variável comentada não é definida.

# Ambiente. production torna PUBLIC_ORIGIN obrigatório e liga COOKIE_SECURE por padrão.
NODE_ENV=production

# Endereço público exato do site (esquema + domínio, sem barra no fim). Requisições que alteram
# dados vindas de outra origem recebem 403 bad_origin.
PUBLIC_ORIGIN=https://mosaic.example.com

# Cadastro público pela tela de login. false = contas só pela CLI (user:create).
ALLOW_SIGNUP=false

# Cookie de sessão só por HTTPS. Mantenha true; false só para testar sem HTTPS.
COOKIE_SECURE=true

# Proxy reverso na frente do app (Caddy ou nginx): 1 = confia só no proxy imediato, para o rate
# limit ver o IP real de cada visitante. Sem proxy nenhum: false.
TRUST_PROXY=1

# Dias de validade da sessão, renovada a cada uso.
SESSION_TTL_DAYS=30

# Máximo de padrões salvos por conta.
MAX_PATTERNS_PER_USER=500

# Nível de log: fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# --- Só sem Docker (systemd). No Docker a imagem já define estas quatro: deixe comentadas. ---
# Interface de escuta: 127.0.0.1 deixa o app acessível só pelo nginx da mesma máquina.
# HOST=127.0.0.1
# Porta HTTP do app.
# PORT=3000
# Arquivo do banco SQLite (o diretório é criado se não existir).
# DATABASE_PATH=/var/lib/mosaic-crochet/mosaic.db
# Pasta da SPA buildada (npm run build); relativa ao WorkingDirectory do serviço.
# STATIC_DIR=./dist
